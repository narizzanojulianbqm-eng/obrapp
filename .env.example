# Base de datos (SQLite local por defecto; en producción usar Turso/libSQL: libsql://...)
DATABASE_URL=file:data/obrapp.db
DATABASE_AUTH_TOKEN=
# Clave para firmar sesiones (generar una larga y aleatoria)
AUTH_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# IA: la plataforma paga el consumo desde esta cuenta centralizada
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# URL pública (para links en notificaciones y webhook)
APP_URL=http://localhost:3000

# ── WhatsApp Business Platform (Cloud API oficial de Meta) ── ver docs/whatsapp.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_IDIOMA=es_AR
WHATSAPP_TEMPLATE_BIENVENIDA=bienvenida_obra
WHATSAPP_TEMPLATE_AVISO=aviso_obra
# Simulador de WhatsApp en la web: automático sin credenciales; "on" para forzarlo, "off" para apagarlo
WHATSAPP_SIMULADOR=
# Transcripción de audios (opcional)
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
